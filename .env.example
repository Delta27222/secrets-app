# URL pública de esta app Next.js (OAuth callbacks). En local suele ser:
NEXTAUTH_URL=http://localhost:3000

# Secreto para firmar JWT y cookies de NextAuth (mín. ~32 caracteres en producción).
# Generar uno seguro: openssl rand -base64 32
NEXTAUTH_SECRET=

# OAuth App de GitHub: https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# URL base del backend API (expuesta al navegador). Si se omite, el código usa:
# https://tek-secrets.onrender.com
NEXT_PUBLIC_API_URL=
