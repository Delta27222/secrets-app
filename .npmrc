# El scope @secrets-27222633 se resuelve desde GitHub Packages (paquete privado).
# Define GITHUB_TOKEN (con permiso read:packages) antes de correr npm install,
# tanto en local como en CI/prod. Sin la variable seteada, npm install falla
# con 401/404 al intentar descargar @secrets-27222633/sdk.
@secrets-27222633:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
