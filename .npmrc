# El scope @secrets-27222633 se resuelve desde GitHub Packages (paquete privado).
# En local, la dependencia usa file:../ y NO consulta el registro.
# En CI/prod, define GITHUB_TOKEN (con permiso read:packages) para instalar.
@secrets-27222633:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
